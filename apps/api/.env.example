# ScreenSprout API Environment Variables

# Server
PORT=3000
NODE_ENV=development

# Database
DB_USER=postgres
DB_HOST=localhost
DB_NAME=screensprout
DB_PASSWORD=your_password_here
DB_PORT=5432
DB_SSL_REQUIRED=false

# Authentication
JWT_SECRET=your_jwt_secret_here_min_32_chars
JWT_EXPIRATION=1h
BCRYPT_ROUNDS=10

# Note: In production, JWT_SECRET and DB_PASSWORD must be set via K8s secrets.
# DB_SSL_REQUIRED should be set to 'true' in production.
# BCRYPT_ROUNDS is forced to 1 in test environment for speed.